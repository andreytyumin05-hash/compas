# Режим: cascade = Gemini → лёгкий Groq → сильный Groq → OpenRouter
LLM_PROVIDER=cascade

# Код + vision (бесплатный лимит Google) — поставь в первую очередь
GEMINI_API_KEY=
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.6-flash
LLM_GEMINI_MODEL=gemini-3.6-flash

# Запасной провайдер (лимиты отдельные)
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b

# Опционально free-модели
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

TELEGRAM_BOT_TOKEN=
