# === LLM Provider ===
# Выберите один: groq | gemini | openrouter
LLM_PROVIDER=groq

# Groq (https://console.groq.com) — бесплатный лимит
GROQ_API_KEY=

# Google AI Studio / Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# Модели Groq (что обычно доступно на free):
#   llama-3.1-8b-instant          — быстро, стабильно на free (рекомендуется)
#   llama-3.3-70b-versatile       — сильнее, но иногда нет доступа на free
#   openai/gpt-oss-20b
# Gemini: gemini-2.0-flash, gemini-1.5-flash
# OpenRouter free: meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=llama-3.1-8b-instant

LLM_TEMPERATURE=0.2
