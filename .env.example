# === Генерация кода (текст → Python → КОМПАС) ===
LLM_PROVIDER=groq
GROQ_API_KEY=
# Модель Groq, например llama-3.3-70b-versatile (не для картинок!)
LLM_MODEL=

# === Vision (фото чертежа) — отдельно от LLM_MODEL ===
GEMINI_API_KEY=
VISION_PROVIDER=gemini
# Только имя Gemini, например:
VISION_MODEL=gemini-2.0-flash

# OpenRouter не обязателен (только fallback vision)
# OPENROUTER_API_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=

# COMPAS_DEBUG_COM=1
