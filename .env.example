# LLM cascade: Gemini -> light Groq -> strong Groq -> OpenRouter
LLM_PROVIDER=cascade

# Current Google GenAI SDK
GEMINI_API_KEY=
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.6-flash
LLM_GEMINI_MODEL=gemini-3.6-flash

# Backup provider
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b

# Optional OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Telegram
TELEGRAM_BOT_TOKEN=

# Engineering knowledge layer
# auto = search only when the task looks like a standards/calculation question.
COMPAS_WEB_SEARCH=auto
COMPAS_WEB_RESULTS=5
