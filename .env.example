# === LLM Provider ===
# Выберите один: groq | gemini | openrouter
LLM_PROVIDER=groq

# Groq (https://console.groq.com) — бесплатный лимит, очень быстрый
GROQ_API_KEY=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

# Google AI Studio / Gemini (https://aistudio.google.com) — бесплатный лимит
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai) — есть бесплатные модели
OPENROUTER_API_KEY=

# Модель (примеры):
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Gemini: gemini-2.0-flash, gemini-1.5-flash
# OpenRouter: meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free
LLM_MODEL=llama-3.3-70b-versatile

# Температура генерации (0.0 – 1.0)
LLM_TEMPERATURE=0.2
